{
  "name": "backend.freesewing.org",
  "version": "3.3.0-rc.1",
  "description": "FreeSewing backend",
  "author": "Joost De Cock <joost@joost.at> (https://github.com/joostdecock)",
  "homepage": "https://freesewing.org/",
  "repository": "github:freesewing/freesewing",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/freesewing/freesewing/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://freesewing.org/patrons/join"
  },
  "scripts": {
    "build": "NO_MINIFY=1 node build.mjs",
    "build:container": "./scripts/build-container.sh",
    "ship:container": "npm run build:container && ./scripts/ship-container.sh",
    "dev": "node --watch --watch-path src src/index.mjs",
    "dev:test": "node --watch --watch-path src tests/run-test-backend.mjs",
    "initdb": "node ./scripts/initdb.mjs",
    "prettier": "npx prettier --write 'src/*.mjs' 'tests/*.mjs'",
    "citest": "node --no-warnings --test-concurrency=1 --test",
    "test": "echo \"Use npm run  to run tests, but it requires running the backend service in test mode (npm run test:backend)\"",
    "ctest": "c8 --reporter=html --reports-dir=coverage node --no-warnings --test-concurrency=1 --test tests/all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.592.0",
    "@freesewing/config": "^4.5.0",
    "axios": "^1.13.6",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "js-yaml": "4.1.0",
    "lodash": "^4.17.23",
    "lodash.get": "4.4.2",
    "mustache": "4.2.0",
    "node-jose": "^2.2.0",
    "oidc-provider": "^8.8.1",
    "otplib": "12.0.1",
    "passport": "0.7.0",
    "passport-http": "0.3.0",
    "passport-jwt": "4.0.1",
    "pino": "9.2.0",
    "qrcode": "1.5.3",
    "swagger-ui-dist": "5.17.10",
    "swagger-ui-express": "5.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "5.1.1",
    "chai-http": "5.1.1",
    "esbuild": "0.21.3",
    "glob": "^11.0.0",
    "mocha": "10.4.0",
    "mocha-steps": "1.3.0"
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "private": true
}
