#
# This file holds environment variables to configure the service.
#

# Name of the service
SERVICE_NAME=backend

# Docker network to attach to
SERVICE_NETWORK=traefiknet

# Config folder
SERVICE_CONFIG_ROOT=/etc/backend

# Logs folder
SERVICE_LOG_ROOT=/var/log/backend

# Container name to run
CONTAINER_NAME=freesewing/backend

# Container tag (version) to run
CONTAINER_TAG=v4.9.0
